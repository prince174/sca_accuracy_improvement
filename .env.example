DEEPSEEK_API_KEY=
SCA_LLM_API_KEY=
SCA_LLM_BASE_URL=https://api.deepseek.com/v1
SCA_LLM_MODEL=deepseek-v4-flash
SCA_LLM_TIMEOUT_SECONDS=120
# Empty values preserve provider defaults; explicit settings make experiments auditable.
SCA_LLM_THINKING=
SCA_LLM_REASONING_EFFORT=
SCA_LLM_MAX_TOKENS=
DEPENDENCY_TRACK_URL=
DEPENDENCY_TRACK_API_KEY=
DEPENDENCY_TRACK_TIMEOUT_SECONDS=120
SCA_API_TOKEN=
SCA_WORKERS=2
SCA_API_TOKEN_FILE=
SCA_TEAMCITY_HOSTS=teamcity.xxx
SCA_BITBUCKET_HOSTS=bitbucket.xxx
SCA_NEXUS_HOSTS=nexus.xxx
SCA_TEAMCITY_TOKEN=
SCA_TEAMCITY_TOKEN_FILE=
SCA_BITBUCKET_TOKEN=
SCA_BITBUCKET_TOKEN_FILE=
SCA_CA_BUNDLE=
SCA_MAX_SBOM_BYTES=67108864
SCA_BIND_ADDRESS=127.0.0.1
SCA_PORT=8080
SCA_POSTGRES_PASSWORD=
# Optional for CLI or a separately managed PostgreSQL instance:
SCA_EVIDENCE_DSN=
SCA_EVIDENCE_BLOBS=workspace/evidence-blobs
