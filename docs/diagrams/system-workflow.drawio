        </mxCell>
        <mxCell id="llm" value="&lt;b&gt;Модель: apply / defer + основание&lt;/b&gt;&lt;br&gt;DeepSeek API или локальный endpoint" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#607D8B;fontSize=20;fontFamily=Arial;spacing=12;">
          <mxGeometry as="geometry" x="500" y="560" width="540" height="95" />
        </mxCell>
        <mxCell id="validator" value="&lt;b&gt;Независимая проверка&lt;/b&gt;&lt;br&gt;ID кандидата · сильная metadata · однозначный SHA-256" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#607D8B;fontSize=20;fontFamily=Arial;spacing=12;">
          <mxGeometry as="geometry" x="500" y="695" width="540" height="95" />
        </mxCell>
        <mxCell id="apply" value="Применить add / replace_identity&lt;br&gt;Повторная сверка и обогащение SBOM" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#607D8B;fontSize=20;fontFamily=Arial;spacing=12;">
          <mxGeometry as="geometry" x="500" y="830" width="540" height="95" />
        </mxCell>
        <mxCell id="output" value="sbom.enriched.json + sbom.original.json&lt;br&gt;decisions.json + assessment.json + provenance" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#607D8B;fontSize=20;fontFamily=Arial;spacing=12;">
          <mxGeometry as="geometry" x="500" y="965" width="540" height="95" />
        </mxCell>
        <mxCell id="consumer" value="Внешний pipeline получает результат&lt;br&gt;Обновляет проект в Dependency-Track" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#607D8B;fontSize=20;fontFamily=Arial;spacing=12;">
          <mxGeometry as="geometry" x="500" y="1100" width="540" height="95" />
        </mxCell>
        <mxCell id="limits" value="&lt;b&gt;Границы решений&lt;/b&gt;&lt;br&gt;&lt;br&gt;Необнаружение ≠ отсутствие.&lt;br&gt;Удаление по одному scan miss запрещено.&lt;br&gt;CVE не подавляются.&lt;br&gt;Контейнер не запускается.&lt;br&gt;&lt;br&gt;Замена по SHA-256 сейчас: Java.&lt;br&gt;Добавления: все поддержанные экосистемы." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#607D8B;fontSize=20;fontFamily=Arial;spacing=12;">
