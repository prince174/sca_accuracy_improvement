        <mxCell id="dt" value="&lt;b&gt;Dependency-Track&lt;/b&gt;&lt;br&gt;&lt;br&gt;Обновляется внешним pipeline" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCFCE7;strokeColor=#4ADE80;fontColor=#172B4D;fontFamily=Arial;fontSize=18;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
