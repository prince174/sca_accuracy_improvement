<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="sca-workflow" name="Модель и проверка">
    <mxGraphModel page="1" pageWidth="1600" pageHeight="1500">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;SCA Accuracy Improvement&lt;/b&gt;&lt;br&gt;Модель оценивает компоненты — код включает TP &amp;gt;70%" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#607D8B;fontSize=20;fontFamily=Arial;spacing=12;">
          <mxGeometry as="geometry" x="40" y="20" width="1500" height="90" />
        </mxCell>
