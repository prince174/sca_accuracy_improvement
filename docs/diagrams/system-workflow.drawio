          <mxGeometry as="geometry" x="500" y="150" width="540" height="95" />
        </mxCell>
        <mxCell id="sbom" value="TeamCity&lt;br&gt;Исходный CycloneDX SBOM" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#607D8B;fontSize=20;fontFamily=Arial;spacing=12;">
          <mxGeometry as="geometry" x="70" y="285" width="420" height="95" />
        </mxCell>
        <mxCell id="source" value="Bitbucket checkout&lt;br&gt;Syft: манифесты и lock-файлы" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#607D8B;fontSize=20;fontFamily=Arial;spacing=12;">
          <mxGeometry as="geometry" x="570" y="285" width="420" height="95" />
        </mxCell>
        <mxCell id="image" value="Nexus → image ID → archive&lt;br&gt;Syft + Java: metadata, пути, SHA-256" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#607D8B;fontSize=20;fontFamily=Arial;spacing=12;">
          <mxGeometry as="geometry" x="1070" y="285" width="420" height="95" />
        </mxCell>
        <mxCell id="evidence" value="Сопоставление и кандидаты изменений&lt;br&gt;SBOM ↔ образ; SBOM ↔ исходники" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#607D8B;fontSize=20;fontFamily=Arial;spacing=12;">
