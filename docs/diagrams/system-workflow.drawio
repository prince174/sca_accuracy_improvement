          <mxGeometry as="geometry" x="500" y="560" width="540" height="95" />
        </mxCell>
        <mxCell id="validator" value="&lt;b&gt;Проверка полноты и контракта&lt;/b&gt;&lt;br&gt;ID · числовые баллы · ссылки evidence" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#607D8B;fontSize=20;fontFamily=Arial;spacing=12;">
          <mxGeometry as="geometry" x="500" y="695" width="540" height="95" />
        </mxCell>
        <mxCell id="apply" value="&lt;b&gt;Фильтр: включить TP &amp;gt;70%&lt;/b&gt;&lt;br&gt;70% исключается; очистить ссылки; сохранить оригинал" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#607D8B;fontSize=20;fontFamily=Arial;spacing=12;">
          <mxGeometry as="geometry" x="500" y="830" width="540" height="95" />
        </mxCell>
        <mxCell id="output" value="sbom.enriched.json + sbom.original.json&lt;br&gt;component-scores.json + report.html + provenance" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#607D8B;fontSize=20;fontFamily=Arial;spacing=12;">
          <mxGeometry as="geometry" x="500" y="965" width="540" height="95" />
        </mxCell>
        <mxCell id="consumer" value="Внешний pipeline получает результат&lt;br&gt;Обновляет проект в Dependency-Track" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#607D8B;fontSize=20;fontFamily=Arial;spacing=12;">
