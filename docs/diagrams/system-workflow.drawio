  <diagram id="sca-workflow" name="Работа системы">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;SCA Accuracy Improvement&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Ссылки на артефакты → проверка состава → обновлённый SBOM для каждого образа&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F8FAFC;strokeColor=none;fontColor=#172B4D;fontFamily=Arial;fontSize=25;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="75" as="geometry" />
        </mxCell>
        <mxCell id="boundary" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0F7FF;strokeColor=#93B4D7;fontColor=#172B4D;fontFamily=Arial;fontSize=19;spacing=15;align=left;verticalAlign=middle;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="400" y="100" width="980" height="1045" as="geometry" />
        </mxCell>
        <mxCell id="boundarylabel" value="&lt;b&gt;СЕРВИС НА LINUX · анализ без запуска целевого контейнера&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F0F7FF;strokeColor=none;fontColor=#172B4D;fontFamily=Arial;fontSize=20;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="290" width="900" height="45" as="geometry" />
        </mxCell>
        <mxCell id="request" value="&lt;b&gt;Внешний pipeline&lt;/b&gt;&lt;br&gt;&lt;br&gt;URL SBOM + образы Nexus&lt;br&gt;Bitbucket URL + точный commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#A78BFA;fontColor=#172B4D;fontFamily=Arial;fontSize=18;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="340" height="135" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;1. HTTP API · POST /v2/analyses&lt;/b&gt;&lt;br&gt;&lt;br&gt;Авторизация → проверка hosts и commit → явные группы SBOM / images" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#60A5FA;fontColor=#172B4D;fontFamily=Arial;fontSize=19;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="440" y="120" width="880" height="115" as="geometry" />
        </mxCell>
        <mxCell id="job" value="&lt;b&gt;Задание и состояние&lt;/b&gt;&lt;br&gt;&lt;br&gt;UUID · queued → running&lt;br&gt;→ succeeded / failed&lt;br&gt;GET /v2/analyses/{id}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#A78BFA;fontColor=#172B4D;fontFamily=Arial;fontSize=18;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1420" y="120" width="340" height="135" as="geometry" />
        </mxCell>
        <mxCell id="tc" value="&lt;b&gt;TeamCity&lt;/b&gt;&lt;br&gt;&lt;br&gt;Один или несколько&lt;br&gt;sbom.json из билдов" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#172B4D;fontFamily=Arial;fontSize=19;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="355" width="300" height="115" as="geometry" />
        </mxCell>
        <mxCell id="bb" value="&lt;b&gt;Bitbucket&lt;/b&gt;&lt;br&gt;&lt;br&gt;HTTPS clone URL&lt;br&gt;Полный hash commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#172B4D;fontFamily=Arial;fontSize=19;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="300" height="115" as="geometry" />
        </mxCell>
        <mxCell id="nx" value="&lt;b&gt;Nexus registry&lt;/b&gt;&lt;br&gt;&lt;br&gt;Один или несколько образов&lt;br&gt;Предпочтительно по digest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#172B4D;fontFamily=Arial;fontSize=18;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="765" width="300" height="115" as="geometry" />
        </mxCell>
        <mxCell id="download" value="&lt;b&gt;2. Скачать SBOM&lt;/b&gt;&lt;br&gt;&lt;br&gt;HTTPS · проверка JSON&lt;br&gt;SHA-256 исходного файла" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#93B4D7;fontColor=#172B4D;fontFamily=Arial;fontSize=18;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="440" y="355" width="270" height="115" as="geometry" />
        </mxCell>
        <mxCell id="declared" value="&lt;b&gt;Заявленные компоненты&lt;/b&gt;&lt;br&gt;&lt;br&gt;Общие идентификаторы Package URL:&lt;br&gt;экосистема · имя · версия · qualifiers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#93B4D7;fontColor=#172B4D;fontFamily=Arial;fontSize=18;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="355" width="570" height="115" as="geometry" />
        </mxCell>
        <mxCell id="checkout" value="&lt;b&gt;3. Получить исходники&lt;/b&gt;&lt;br&gt;&lt;br&gt;Git fetch / checkout&lt;br&gt;Сверить HEAD с commit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#93B4D7;fontColor=#172B4D;fontFamily=Arial;fontSize=18;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="440" y="540" width="270" height="115" as="geometry" />
        </mxCell>
        <mxCell id="source" value="&lt;b&gt;Syft: исходники&lt;/b&gt;&lt;br&gt;&lt;br&gt;Манифесты и lock-файлы&lt;br&gt;Без запуска сборщиков" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#CCFBF1;strokeColor=#2DD4BF;fontColor=#172B4D;fontFamily=Arial;fontSize=18;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="540" width="250" height="115" as="geometry" />
        </mxCell>
        <mxCell id="sourcecompare" value="&lt;b&gt;SBOM ↔ исходники&lt;/b&gt;&lt;br&gt;&lt;br&gt;Отдельное сравнение&lt;br&gt;Декларации проекта" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#60A5FA;fontColor=#172B4D;fontFamily=Arial;fontSize=18;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="540" width="250" height="115" as="geometry" />
        </mxCell>
        <mxCell id="save" value="&lt;b&gt;4. Получить образ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pull → закрепить image ID&lt;br&gt;→ docker image save" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#93B4D7;fontColor=#172B4D;fontFamily=Arial;fontSize=18;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="440" y="765" width="270" height="115" as="geometry" />
        </mxCell>
        <mxCell id="image" value="&lt;b&gt;Syft: образ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Итоговый состав слоёв&lt;br&gt;Пакеты и их расположение" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#CCFBF1;strokeColor=#2DD4BF;fontColor=#172B4D;fontFamily=Arial;fontSize=18;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="765" width="250" height="115" as="geometry" />
        </mxCell>
        <mxCell id="compare" value="&lt;b&gt;SBOM ↔ образ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Совпадение / нет данных&lt;br&gt;Новая или другая версия" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#60A5FA;fontColor=#172B4D;fontFamily=Arial;fontSize=18;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="765" width="250" height="115" as="geometry" />
        </mxCell>
        <mxCell id="java" value="&lt;b&gt;Java: дополнительные статические ссылки на методы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0F2FE;strokeColor=#7DD3FC;fontColor=#172B4D;fontFamily=Arial;fontSize=17;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="905" width="570" height="60" as="geometry" />
        </mxCell>
        <mxCell id="output" value="&lt;b&gt;5. Результат для каждой пары SBOM / образ&lt;/b&gt;&lt;br&gt;&lt;br&gt;sbom.enriched.json + отчёты + provenance&lt;br&gt;Commit · SHA-256 SBOM · фактический image ID" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCFCE7;strokeColor=#4ADE80;fontColor=#172B4D;fontFamily=Arial;fontSize=19;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="1010" width="570" height="110" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="&lt;b&gt;Опциональная LLM&lt;/b&gt;&lt;br&gt;&lt;br&gt;DeepSeek API / локальная модель&lt;br&gt;&lt;br&gt;Объясняет расхождения.&lt;br&gt;Не меняет статусы компонентов." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#FBBF24;fontColor=#172B4D;fontFamily=Arial;fontSize=18;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1430" y="740" width="330" height="145" as="geometry" />
        </mxCell>
        <mxCell id="consumer" value="&lt;b&gt;6. Внешний pipeline&lt;/b&gt;&lt;br&gt;&lt;br&gt;После succeeded скачивает&lt;br&gt;обновлённые SBOM по HTTP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#A78BFA;fontColor=#172B4D;fontFamily=Arial;fontSize=18;spacing=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
