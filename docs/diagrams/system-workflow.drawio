          <mxGeometry as="geometry" x="1070" y="285" width="420" height="95" />
        </mxCell>
        <mxCell id="evidence" value="Каталог компонентов: SBOM + образ&lt;br&gt;Исходники и coverage — контекст оценки" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#607D8B;fontSize=20;fontFamily=Arial;spacing=12;">
